# Configuração do Compose/deploy, sem secrets da aplicação.
SRES_API_IMAGE=ghcr.io/CHANGE_ME/sres-api
SRES_API_HOST_PORT=18080
SRES_KEYCLOAK_HOST_PORT=18081
SRES_COMPOSE_PROJECT=sres
SRES_APP_ENV_FILE=/opt/sres/app.env
SRES_NETWORK_NAME=sres_internal
SRES_POSTGRES_VOLUME_NAME=sres_postgres_data
SRES_MINIO_VOLUME_NAME=sres_minio_data
# Healthcheck local; sobrescreva somente com URL confiável da instalação.
SRES_HEALTH_URL=http://127.0.0.1:18080/actuator/health
SRES_HEALTH_RETRIES=12
SRES_HEALTH_INTERVAL_SECONDS=5
SRES_HEALTH_TIMEOUT_SECONDS=5
SRES_HEALTH_GLOBAL_TIMEOUT_SECONDS=120
