#!/usr/bin/env bash
set -euo pipefail
output=''
max_time=''
while (($#)); do
  case "$1" in
    -o) output="$2"; shift 2 ;;
    --max-time) max_time="$2"; shift 2 ;;
    *) shift ;;
  esac
done
printf '%s\n' "$max_time" > "${FAKE_CURL_MAX_FILE:?}"
case "${FAKE_CURL_MODE:-up}" in
  up) printf '%s\n' '{"status":"UP"}' > "$output" ;;
  down) printf '%s\n' '{"status":"DOWN"}' > "$output" ;;
  timeout) exit 28 ;;
  *) exit 2 ;;
esac
