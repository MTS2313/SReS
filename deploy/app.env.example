# Runtime da API e dos serviços persistentes. Copie para /opt/sres/app.env
# e substitua os placeholders fora do repositório. Este arquivo não é produção.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TZ=America/Sao_Paulo

# PostgreSQL compartilhado: a API usa public; Keycloak usa o schema keycloak.
POSTGRES_DB=sres
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sres
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Keycloak produtivo: não use o realm/usuários sres-dev.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/sres
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
KC_HOSTNAME=keycloak.example.invalid
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false
SRES_KEYCLOAK_ISSUER=https://keycloak.example.invalid/realms/sres-prod

# MinIO privado; o bucket é criado de modo idempotente pela aplicação no uso.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
SRES_STORAGE_ENDPOINT=http://minio:9000
SRES_STORAGE_ACCESS_KEY=CHANGE_ME
SRES_STORAGE_SECRET_KEY=CHANGE_ME
SRES_STORAGE_BUCKET=sres-reports

# Integrações opcionais.
SRES_OLLAMA_ENABLED=false
SRES_OLLAMA_BASE_URL=http://ollama.example.invalid:11434
SRES_OLLAMA_MODEL=CHANGE_ME
SRES_TELEGRAM_ENABLED=false
SRES_TELEGRAM_TOKEN=CHANGE_ME

# Documentação pode ser restringida/desabilitada no ambiente produtivo.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
